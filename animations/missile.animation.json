{
  "format_version": "1.10.0",
  "animations": {
    "animation.civ.missile.flight": {
      "loop": true,
      "animation_length": 12,
      "bones": {
        "root": {
          "position": [
            "math.sin(query.anim_time * 60 + 40) * 0.4",
            "math.sin(query.anim_time * 90) * 0.5",
            0
          ],
          "rotation": [
            "math.sin(query.anim_time * 90 + 30) * 1.2",
            "math.sin(query.anim_time * 60) * 1.0",
            0
          ]
        },
        "body": { "rotation": [0, 0, "query.anim_time * 30"] }
      }
    },
    "animation.civ.missile.burn": {
      "loop": true,
      "animation_length": 0.4,
      "bones": {
        "flame": {
          "scale": [
            "1 + math.sin(query.anim_time * 1800) * 0.14",
            "1 + math.sin(query.anim_time * 1800 + 90) * 0.14",
            "1 + math.sin(query.anim_time * 1440 + 60) * 0.35"
          ]
        }
      }
    }
  }
}
